# The only required setting: token from @BotFather (/newbot).
BOT_TOKEN=123456:ABC-your-token-here

# --- Everything below is optional ---

# Group admins are tracker admins automatically. Add extra admin user IDs
# here if needed (comma-separated; get IDs from @userinfobot).
# ADMIN_IDS=11111111,22222222

# Announcement group is captured automatically when the bot is added to a
# group. Set this only to force a specific chat.
# GROUP_CHAT_ID=

# One-tap open link from @BotFather /newapp (see DEPLOY.md "Optional polish").
# MINIAPP_LINK=https://t.me/YourBot/tracker

# Public HTTPS URL. Auto-detected on Render/Railway/Fly; set manually only
# elsewhere (e.g. your own VPS or a dev tunnel).
# PUBLIC_URL=https://your-domain.example

# Storage (defaults are fine; Docker image sets these to /data/*)
# DB_PATH=tracker.db
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=10

# Local development ONLY: open http://localhost:8080 in a normal browser,
# authenticated as this user id, bypassing Telegram signature checks.
# NEVER set in production.
# DEV_USER_ID=11111111
